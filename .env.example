# Telegram: @BotFather -> /newbot
TELEGRAM_BOT_TOKEN=
# ID единственного пользователя, которому разрешён доступ (узнать: @userinfobot)
# Пока пусто — бот отказывает всем
ALLOWED_USER_ID=

# Yandex SpeechKit: https://console.yandex.cloud -> сервис SpeechKit
# API-ключ (предпочтительно) или IAM-токен (живёт 12 часов)
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# YANDEX_IAM_TOKEN=

# Pexels: https://www.pexels.com/api/ -> бесплатный ключ
PEXELS_API_KEY=
# Pixabay: https://pixabay.com/api/docs/ -> бесплатный ключ (fallback для Pexels)
PIXABAY_API_KEY=

# Источник видео-подложки:
#   auto  — если в тексте есть игра, берётся её официальный трейлер из Steam,
#           иначе сток с Pexels/Pixabay (рекомендуется)
#   steam — только Steam (ошибка, если игра не распознана)
#   pexels — только Pexels (с Pixabay fallback)
VIDEO_SOURCE=auto
# Минимум клипов на фразу из Pexels, иначе подключается Pixabay fallback
MIN_CLIPS_PER_PHRASE=2
# Минимальное разрешение клипов (ниже — будет мыльно после upscale до 1080x1920)
MIN_CLIP_WIDTH=720

# Кэш скачанных клипов (Steam/Pexels/Pixabay)
CACHE_DIR=cache
CACHE_TTL_DAYS=7
MAX_CACHE_SIZE_MB=500

# Параллельный рендер
RENDER_CONCURRENCY=2
# Таймаут одного ffmpeg-рендера (сек)
RENDER_TIMEOUT_SECONDS=600

# Сколько генераций (заданий) может выполняться параллельно.
# Рендер (ffmpeg) дополнительно лимитируется RENDER_CONCURRENCY.
JOB_CONCURRENCY=2

# Приведение к 9:16: blur — размытая подложка (рекомендуется для трейлеров 16:9),
# crop — жёсткая обрезка по центру
VIDEO_PADDING=blur

# --- Опционально: LLM для извлечения ключевых слов (гибрид) ---
# Если ключ не задан — работает эвристика (частота слов).
# Поддерживается любой OpenAI-совместимый API (OpenAI, OpenRouter, YandexGPT и т.п.)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Провайдер LLM: openai (OpenAI-совместимый API) — единственный на данный момент
LLM_PROVIDER=openai
# Способ авторизации: auto (по префиксу ключа) | bearer | api-key
LLM_AUTH_TYPE=auto
# Имя HTTP-заголовка авторизации (по умолчанию Authorization)
LLM_AUTH_HEADER=Authorization
LLM_TIMEOUT=60
LLM_RETRIES=2

# --- Настройки сценария и сцен (v2.0) ---
# on — генерировать текст сценария (хук/тело/концовка) через LLM перед озвучкой
# off — использовать исходный текст как есть (по умолчанию)
# auto — генерировать только если исходный текст слишком длинный/короткий
SCRIPT_GENERATION=off
# Максимум сцен в одном ролике
SCENES_MAX=12

# --- Тайминги / forced alignment (v2.0.1) ---
# Максимальное время транскрипции whisper (сек). По истечении — пропорциональный fallback.
ALIGNMENT_TIMEOUT_SECONDS=30

# --- Хранилище и кэш (v2.0) ---
# Директория для БД и служебных файлов
DATA_DIR=data
# Файл SQLite-базы (пользователи, история генераций)
DB_PATH=data/video_bot.db
# Артефакты каждого задания: data/jobs/<JOB_ID>/{input,tts,video,subtitles,output}
JOB_DIR=data/jobs
# Ша256-кэш скачанных клипов (deduplication по содержимому)
CACHE_ENABLED=true

# --- Стиль субтитров по умолчанию (v2.0) ---
# classic | tiktok | news | gaming | minimal
SUBTITLE_STYLE=tiktok

# --- Fallback-фон для видео (v2.0.1) ---
# Если ни один клип не найден — сначала ищется стоковое фото (Pexels/Pixabay),
# которое превращается в видеоклип с эффектом Ken Burns (медленный зум).
# Если фото тоже нет — генерируется анимированный градиент.
IMAGE_FALLBACK=true
# Период одного «кадра» Ken Burns в секундах: зум повторяется каждые N секунд
IMAGE_KEN_BURNS=4.0

# --- Фоновая музыка (опционально) ---
# Помещай .mp3/.wav файлы в папку music/ рядом с bot.py
# True/1/yes — включить
BACKGROUND_MUSIC=false
# Путь к файлу с фоновой музыкой (по умолчанию music/ambience.mp3)
BG_MUSIC_PATH=music/ambience.mp3
# Громкость фоновой музыки в dB (относительно диалога, напр. -23)
BG_MUSIC_VOLUME=-23

# --- Настройки озвучки (мужской энергичный по умолчанию) ---
# zahar поддерживает только: neutral, good (evil — ошибка API)
TTS_VOICE=zahar
TTS_EMOTION=good
TTS_SPEED=1.0
TTS_LANG=ru-RU
# Кроссфейд между чанками TTS (секунды), убирает шов интонации
TTS_CROSSFADE=0.05
# Отключить кроссфейд (склейка внахлёст) — для отладки
# TTS_DISABLE_CROSSFADE=1

# --- Настройки субтитров ---
# Шрифт субтитров (на Linux Arial подставится из Liberation Sans)
SUB_FONT=Arial
SUB_FONTSIZE=64
# Выделение ключевых слов и чисел другим цветом в субтитрах (ASS \c override)
SUB_HIGHLIGHT_KEYWORDS=false
SUB_HIGHLIGHT_COLOR=&H0000FF&  # цвет выделения (BGR hex)
# Karaoke-анимация появления слов по буквам (\k-теги в ASS)
# Требует word-level timestamps (Yandex ASR или whisper)
SUB_KARAOKE=false

# --- Лимиты ---
# MAX_VIDEO_SYMBOLS=3500
# MAX_PARTS=4
# MAX_VIDEO_DURATION=75
# Порог предупреждения о длинном ролике (для удержания attention в Shorts/Reels)
# VIDEO_DURATION_WARN_THRESHOLD=45